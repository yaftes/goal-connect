# Goal Connect — environment template (copy to `.env.local` in apps or export for API)

# Browser + Next.js apps (`apps/player-web`, `apps/scout-web`)
NEXT_PUBLIC_API_URL=http://localhost:3005

# SQLite file used by `@goal-connect/db` (optional override)
# GOAL_CONNECT_DB_PATH=/absolute/path/to/goal-connect.db

# API (`packages/api`)
PORT=3005
